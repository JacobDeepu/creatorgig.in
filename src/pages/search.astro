---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { APP } from '../consts';
---

<Base title="Search creators — creatorgig" description="Search verified creators on creatorgig." path="/search">
  <Navbar />
  <main id="main" class="container-x section pt-32 text-center">
    <span class="grid mx-auto size-14 place-items-center rounded-2xl bg-grad-main text-white">
      <Icon name="users" size={24} />
    </span>
    <h1 class="mt-6 text-[clamp(2rem,6vw,3.25rem)]">Find your <span class="text-gradient">creators.</span></h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-muted">
      Creator search is launching with the app. Jump in to browse verified creators and post briefs.
    </p>
    <p id="search-q" class="mt-4 text-sm text-muted"></p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href={APP.signup} variant="primary" size="lg" data-magnetic>Get started</Button>
      <Button href="/" variant="secondary" size="lg">Back home</Button>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');
  const el = document.getElementById('search-q');
  if (q && el) el.textContent = `You searched for “${q}” — we’ll have results soon.`;
</script>
