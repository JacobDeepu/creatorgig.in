---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { APP } from '../consts';
---

<section id="ai" class="section relative overflow-hidden">
  <div class="mesh" aria-hidden="true" style="opacity:.35"></div>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-2">
    <!-- Copy -->
    <div data-reveal>
      <span class="inline-flex items-center gap-2 text-sm font-semibold text-gradient">
        <Icon name="sparkles" size={16} /> AI assistant
      </span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        Your AI co-pilot. <span class="text-gradient">50 credits on us.</span>
      </h2>
      <p class="mt-4 max-w-md text-lg text-muted">
        Stuck on what to say? AI writes your pitch, your brief, your bio — in seconds.
        50 free credits. Use them before they’re gone.
      </p>
      <div class="mt-7">
        <Button href={APP.signup} variant="primary" size="lg" data-magnetic>
          Try the AI assistant
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>

    <!-- Chat mockup -->
    <div data-reveal aria-hidden="true">
      <div class="mx-auto max-w-md overflow-hidden rounded-2xl border border-border bg-card shadow-[0_30px_70px_-30px_rgba(0,0,0,0.8)]">
        <div class="flex items-center gap-2 border-b border-border bg-surface px-4 py-3">
          <span class="grid size-7 place-items-center rounded-lg bg-grad-main text-white">
            <Icon name="sparkles" size={14} />
          </span>
          <span class="text-sm font-semibold">creatorgig AI</span>
          <span
            id="ai-credits"
            class="ml-auto rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold text-muted"
          >
            50 credits
          </span>
        </div>

        <div class="space-y-3 p-4">
          <p class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-surface px-3.5 py-2 text-sm">
            Write a pitch for a skincare brand 💅
          </p>
          <div class="max-w-[88%] rounded-2xl rounded-bl-sm bg-grad-main p-px">
            <div class="rounded-[15px] bg-card px-3.5 py-2.5 text-sm">
              <span id="ai-typed"></span><span id="ai-caret" class="ai-caret">▌</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2 border-t border-border px-4 py-3">
          <span class="flex-1 rounded-full border border-border bg-surface px-3 py-2 text-xs text-muted">
            Ask creatorgig AI anything…
          </span>
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-grad-main text-white">
            <Icon name="send" size={15} />
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ai-caret { animation: blink 1s step-end infinite; color: var(--color-hotpink); }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ai-caret { display: none; } }
</style>

<script>
  const typed = document.getElementById('ai-typed');
  const caret = document.getElementById('ai-caret');
  const credits = document.getElementById('ai-credits');
  const text =
    "Hey! I’m Aria — I make skincare content for 248K engaged followers in India. I’d love to feature your launch with a Reel + Story bundle. My audience is 70% women, 18–28. Let’s make something that actually converts. ✨";

  if (typed) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      typed.textContent = text;
    } else {
      // Start typing only when scrolled into view, once.
      const start = () => {
        let i = 0;
        const tick = () => {
          typed.textContent = text.slice(0, i);
          i++;
          if (i <= text.length) {
            setTimeout(tick, 22 + Math.round((i % 3) * 8));
          } else {
            if (credits) credits.textContent = '49 credits';
            if (caret) caret.style.display = 'none';
          }
        };
        tick();
      };
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              start();
              obs.disconnect();
            }
          });
        },
        { threshold: 0.4 }
      );
      obs.observe(typed);
    }
  }
</script>
