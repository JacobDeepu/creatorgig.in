---
import Icon from './Icon.astro';

const faqs = [
  {
    q: 'Is it free to join?',
    a: 'Yes — creating a profile, listing gigs, and browsing briefs is completely free. You also get 50 AI credits to start, no card required.',
  },
  {
    q: 'How do payments work?',
    a: 'Payments are held securely once a deal is agreed, and released when the work is delivered — so creators get paid and brands get what they paid for.',
  },
  {
    q: 'Which platforms do you support?',
    a: 'Connect Instagram, YouTube and Facebook for live, verified analytics — no screenshots, no guessing. More platforms are on the way.',
  },
  {
    q: 'What’s the AI assistant?',
    a: 'A built-in co-pilot that drafts pitches, briefs and bios in seconds. New accounts get 50 free credits to try it out.',
  },
] as const;
---

<section class="section">
  <div class="container-x max-w-3xl">
    <div class="text-center" data-reveal>
      <span class="text-sm font-semibold text-gradient">FAQ</span>
      <h2 class="mt-3 text-[clamp(1.9rem,5vw,3rem)]">Questions? <span class="text-gradient">Answered.</span></h2>
    </div>

    <div class="mt-10 space-y-3" data-stagger>
      {
        faqs.map((f) => (
          <details class="faq group rounded-2xl border border-border bg-card px-5" data-stagger-item>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-lg font-bold tracking-tight">
              {f.q}
              <Icon
                name="chevron-down"
                size={20}
                class="shrink-0 text-muted transition-transform duration-300 group-open:rotate-180 group-open:text-hotpink"
              />
            </summary>
            <p class="pb-5 text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] { border-color: color-mix(in srgb, var(--color-hotpink) 35%, var(--color-border)); }
</style>
