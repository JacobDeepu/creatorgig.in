---
// Accessible creator/business segmented control. Behaviour is wired by the
// consumer (Hero) which listens for clicks on [data-mode] and swaps panels.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  role="tablist"
  aria-label="Choose your view"
  class={`audience-toggle inline-flex rounded-full border border-border bg-surface p-1 ${className}`}
>
  <button
    role="tab"
    type="button"
    id="tab-creator"
    data-mode="creator"
    aria-selected="true"
    aria-controls="panel-creator"
    class="rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors duration-300 aria-selected:bg-grad-main aria-selected:text-white aria-selected:shadow-[var(--glow-pink)]"
  >
    I’m a creator
  </button>
  <button
    role="tab"
    type="button"
    id="tab-business"
    data-mode="business"
    aria-selected="false"
    aria-controls="panel-business"
    class="rounded-full px-4 py-2 text-sm font-semibold text-muted transition-colors duration-300 aria-selected:bg-grad-main aria-selected:text-white aria-selected:shadow-[var(--glow-pink)]"
  >
    I’m a business
  </button>
</div>
