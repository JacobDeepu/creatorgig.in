---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { APP } from '../consts';

const benefits = [
  { icon: 'file-text', title: 'Post a brief in minutes', desc: 'Tell us what you need and set your budget. That’s it.' },
  { icon: 'badge-check', title: 'Discover verified creators', desc: 'Real, connected analytics — not vanity metrics or bought followers.' },
  { icon: 'shield-check', title: 'Negotiate & pay securely', desc: 'Encrypted chat, and payments held safe until the work’s delivered.' },
] as const;

const matches = [
  { i: 'a', h: '@aria', f: '248K', r: '89K', m: '96' },
  { i: 'm', h: '@maya', f: '120K', r: '71K', m: '92' },
  { i: 'k', h: '@kabir', f: '64K', r: '38K', m: '88' },
] as const;
---

<section id="for-business" class="section relative overflow-hidden">
  <div class="container-x grid items-center gap-12 lg:grid-cols-2">
    <!-- Discovery mockup (left) -->
    <div class="order-2 lg:order-1" data-reveal aria-hidden="true">
      <div class="rounded-2xl border border-border bg-card p-4 shadow-[0_30px_70px_-30px_rgba(0,0,0,0.8)]">
        <div class="flex items-center gap-2 rounded-xl border border-border bg-surface px-3 py-2">
          <Icon name="users" size={16} class="text-fuchsia" />
          <span class="text-sm text-muted">skincare · India · 100K+</span>
          <span class="ml-auto rounded-full bg-grad-cool px-2 py-0.5 text-[10px] font-bold text-white">3 matches</span>
        </div>
        <div class="mt-3 space-y-2">
          {
            matches.map((c) => (
              <div class="flex items-center gap-3 rounded-xl border border-border p-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-grad-cool font-display font-bold text-white">
                  {c.i}
                </span>
                <div class="min-w-0 leading-tight">
                  <p class="flex items-center gap-1 text-sm font-semibold">
                    {c.h} <Icon name="badge-check" size={13} class="text-hotpink" />
                  </p>
                  <p class="text-xs text-muted">{c.f} followers · {c.r} verified reach</p>
                </div>
                <span class="ml-auto shrink-0 text-right">
                  <span class="font-display text-lg font-bold text-gradient">{c.m}%</span>
                  <span class="block text-[10px] text-muted">match</span>
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Copy (right) -->
    <div class="order-1 lg:order-2" data-reveal>
      <span class="text-sm font-semibold text-gradient">For business</span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        For brands who are <span class="text-gradient">done guessing.</span>
      </h2>
      <p class="mt-4 max-w-md text-lg text-muted">
        Stop paying for fake followers. Discover creators with analytics you can actually trust.
      </p>

      <ul class="mt-8 space-y-5" data-stagger>
        {
          benefits.map((b) => (
            <li class="flex gap-4" data-stagger-item>
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-grad-main text-white">
                <Icon name={b.icon} size={18} />
              </span>
              <div>
                <h3 class="font-display text-lg font-bold tracking-tight">{b.title}</h3>
                <p class="mt-1 text-sm text-muted">{b.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-8">
        <Button href={APP.postBrief} variant="primary" size="lg" data-magnetic>
          Post your first brief
          <Icon name="arrow-right" size={18} />
        </Button>
      </div>
    </div>
  </div>
</section>
