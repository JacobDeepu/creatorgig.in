---
import Icon from './Icon.astro';

const steps = [
  { n: '01', icon: 'user-round', title: 'Create your profile', desc: 'Connect your socials and get verified in minutes.' },
  { n: '02', icon: 'tag', title: 'List your gigs', desc: 'Set your packages and your prices. You’re the boss.' },
  { n: '03', icon: 'file-text', title: 'Match with brands', desc: 'Apply to briefs or get discovered. No cold DMs.' },
  { n: '04', icon: 'indian-rupee', title: 'Get paid', desc: 'Securely, on time, every time. That’s the whole point.' },
] as const;
---

<section id="how" class="section">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <span class="text-sm font-semibold text-gradient">How it works</span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        From zero to paid in <span class="text-gradient">4 steps.</span>
      </h2>
    </div>

    <ol class="relative mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-stagger>
      <!-- connector line (desktop) -->
      <span
        class="pointer-events-none absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-violet via-hotpink to-electric opacity-40 lg:block"
        aria-hidden="true"
      ></span>

      {
        steps.map((s) => (
          <li class="relative" data-stagger-item>
            <div class="flex items-center gap-4 lg:block">
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-grad-main text-white shadow-[0_10px_30px_-12px_rgba(240,22,122,0.6)]">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="font-display text-5xl font-extrabold text-gradient lg:mt-5 lg:block">
                {s.n}
              </span>
            </div>
            <h3 class="mt-4 font-display text-xl font-bold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
