---
import Icon from './Icon.astro';
---

<section id="features" class="section">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <span class="text-sm font-semibold text-gradient">Features</span>
      <h2 class="mt-3 text-[clamp(2rem,5vw,3.25rem)]">
        Everything you need to <span class="text-gradient">get the bag.</span>
      </h2>
      <p class="mt-4 text-lg text-muted">
        Built for creators who want the deal, the data, and the payout — without the DMs and the guesswork.
      </p>
    </div>

    <div
      class="mt-12 grid auto-rows-[minmax(170px,1fr)] grid-cols-2 gap-4 lg:grid-cols-4"
      data-stagger
    >
      <!-- 1 — Profile (big) -->
      <article
        class="bento group col-span-2 row-span-1 lg:col-span-2 lg:row-span-2"
        data-stagger-item
      >
        <div class="bento-head">
          <span class="bento-ico"><Icon name="user-round" size={18} /></span>
          <h3>One profile. Every platform.</h3>
        </div>
        <p class="bento-desc">All your socials, followers, and best work in one verified profile.</p>
        <div class="mt-auto space-y-2 pt-5">
          {
            [
              ['Instagram', '248K', 'w-[82%]'],
              ['YouTube', '92K', 'w-[48%]'],
              ['Snapchat', '40K', 'w-[28%]'],
            ].map(([net, n, w]) => (
              <div class="flex items-center gap-3">
                <span class="w-20 shrink-0 text-xs text-muted">{net}</span>
                <span class="h-2 flex-1 overflow-hidden rounded-full bg-surface">
                  <span class={`block h-full rounded-full bg-grad-main ${w}`} />
                </span>
                <span class="w-10 shrink-0 text-right text-xs font-semibold">{n}</span>
              </div>
            ))
          }
          <p class="inline-flex items-center gap-1.5 pt-1 text-xs text-muted">
            <Icon name="badge-check" size={14} class="text-hotpink" /> Verified across 6 platforms
          </p>
        </div>
      </article>

      <!-- 2 — Gigs (wide) -->
      <article class="bento group col-span-2 lg:col-span-2" data-stagger-item>
        <div class="bento-head">
          <span class="bento-ico"><Icon name="tag" size={18} /></span>
          <h3>List your gigs. Name your price.</h3>
        </div>
        <p class="bento-desc">Package reels, posts, stories and UGC. You set the rate.</p>
        <div class="mt-auto flex flex-wrap gap-2 pt-5">
          <span class="gig-pill">Reel + Story <b class="text-gradient-warm">₹12,000</b></span>
          <span class="gig-pill">3 Posts <b class="text-gradient-warm">₹8,500</b></span>
          <span class="gig-pill">UGC video <b class="text-gradient-warm">₹6,000</b></span>
        </div>
      </article>

      <!-- 3 — Analytics -->
      <article class="bento group" data-stagger-item>
        <div class="bento-head">
          <span class="bento-ico"><Icon name="trending-up" size={18} /></span>
          <h3 class="text-base">Real analytics.</h3>
        </div>
        <p class="bento-desc">No screenshots. Live and verified.</p>
        <div class="mt-auto pt-3">
          <svg class="h-10 w-full" viewBox="0 0 160 40" fill="none" preserveAspectRatio="none">
            <polyline points="0,32 26,28 52,30 78,18 104,22 130,10 160,6" stroke="url(#spark2)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <defs>
              <linearGradient id="spark2" x1="0" y1="0" x2="160" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#7C3AED" /><stop offset="1" stop-color="#FF6B1A" />
              </linearGradient>
            </defs>
          </svg>
          <p class="mt-1 text-xs font-semibold text-electric">+18% this week</p>
        </div>
      </article>

      <!-- 4 — Briefs -->
      <article class="bento group" data-stagger-item>
        <div class="bento-head">
          <span class="bento-ico"><Icon name="file-text" size={18} /></span>
          <h3 class="text-base">Apply in one tap.</h3>
        </div>
        <p class="bento-desc">Brands post. You pitch. No cold DMs.</p>
        <div class="mt-auto flex items-center justify-between rounded-xl border border-border bg-surface p-3">
          <div class="leading-tight">
            <p class="text-sm font-semibold">Skincare brief</p>
            <p class="text-xs text-muted">₹40k · 5 days</p>
          </div>
          <span class="rounded-full bg-grad-main px-3 py-1 text-xs font-bold text-white">Apply</span>
        </div>
      </article>

      <!-- 5 — Auto-DM (wide) -->
      <article class="bento group col-span-2 lg:col-span-2" data-stagger-item>
        <div class="bento-head">
          <span class="bento-ico"><Icon name="zap" size={18} /></span>
          <h3>Auto-DM that never sleeps.</h3>
          <span class="ml-auto rounded-full border border-border px-2 py-0.5 text-[10px] font-bold text-muted">24/7</span>
        </div>
        <p class="bento-desc">Instagram automations that reply, drop links, and catch leads while you sleep.</p>
        <div class="mt-auto space-y-2 pt-5">
          <span class="dm-bubble dm-in">“link pls?”</span>
          <span class="dm-bubble dm-out">Here you go 🔗 grab 10% off ✨</span>
        </div>
      </article>

      <!-- 6 — Encrypted chat (wide) -->
      <article class="bento group col-span-2 lg:col-span-2" data-stagger-item>
        <div class="bento-head">
          <span class="bento-ico"><Icon name="lock" size={18} /></span>
          <h3>Chats that stay yours.</h3>
        </div>
        <p class="bento-desc">End-to-end encrypted messaging. Negotiate in private.</p>
        <div class="mt-auto space-y-2 pt-5">
          <span class="dm-bubble dm-in">Can you do ₹15k for the bundle?</span>
          <span class="dm-bubble dm-out">Deal. Sending the contract now.</span>
          <p class="inline-flex items-center gap-1.5 text-xs text-muted">
            <Icon name="lock" size={12} class="text-hotpink" /> end-to-end encrypted
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    padding: 1.4rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .bento:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-hotpink) 40%, var(--color-border));
    box-shadow: 0 24px 50px -28px rgba(240, 22, 122, 0.45);
  }
  .bento-head { display: flex; align-items: center; gap: 0.65rem; }
  .bento-head h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .bento-ico {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    background: var(--grad-main);
    color: #fff;
    flex-shrink: 0;
  }
  .bento-desc { margin-top: 0.6rem; color: var(--color-muted); font-size: 0.9rem; }

  .gig-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  .dm-bubble {
    display: inline-block;
    max-width: 85%;
    border-radius: 1rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
  }
  .dm-in {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: 0.25rem;
  }
  .dm-out {
    background: var(--grad-main);
    color: #fff;
    border-bottom-right-radius: 0.25rem;
    margin-left: auto;
  }
  .dm-bubble.dm-out { display: block; width: fit-content; }
</style>
